{
  "schema": 1,
  "runtime": "static-web",
  "execution": "automatic",
  "requireCleanGit": true,
  "verify": [
    "./dev npm test",
    "./dev npm run build",
    "./dev npm run build:site"
  ],
  "deploy": [
    "./dev vercel deploy --prod --yes"
  ],
  "healthchecks": [
    "https://koreanscript.vercel.app/",
    "https://koreanscript.vercel.app/robots.txt",
    "https://koreanscript.vercel.app/sitemap.xml"
  ]
}
