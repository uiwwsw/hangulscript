{
  "name": "hangulscript-vscode",
  "displayName": "한글스크립트",
  "description": "한글스크립트 .hgs 문법 강조, 포맷, 타입 오류, 자동 완성, 타입 정보와 정의로 이동",
  "version": "0.3.0",
  "publisher": "uiwwsw",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uiwwsw/hangulscript.git",
    "directory": "extensions/vscode"
  },
  "main": "./out/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "hangulscript",
        "aliases": [
          "한글스크립트",
          "HangulScript"
        ],
        "extensions": [
          ".hgs"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/hgs-light.svg",
          "dark": "./icons/hgs-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "hangulscript",
        "scopeName": "source.hangulscript",
        "path": "./syntaxes/hangulscript.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[hangulscript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "snippets": [
      {
        "language": "hangulscript",
        "path": "./snippets.json"
      }
    ]
  },
  "icon": "icons/extension.png"
}
