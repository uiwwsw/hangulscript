{
  "name": "hangulscript-vscode",
  "displayName": "한글스크립트 · HangulScript",
  "description": "HangulScript Korean programming language (.hgs): syntax highlighting, formatting, type diagnostics, completion, hover and definitions. 한글 문법 강조·포맷·타입 검사",
  "version": "0.3.1",
  "publisher": "uiwwsw",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uiwwsw/hangulscript.git",
    "directory": "extensions/vscode"
  },
  "main": "./out/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "hangulscript",
        "aliases": [
          "한글스크립트",
          "HangulScript"
        ],
        "extensions": [
          ".hgs"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/hgs-light.svg",
          "dark": "./icons/hgs-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "hangulscript",
        "scopeName": "source.hangulscript",
        "path": "./syntaxes/hangulscript.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[hangulscript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "snippets": [
      {
        "language": "hangulscript",
        "path": "./snippets.json"
      }
    ]
  },
  "icon": "icons/extension.png",
  "keywords": [
    "HangulScript",
    "Korean",
    "Hangul",
    "hgs",
    "한글스크립트"
  ],
  "homepage": "https://hangulscript.vercel.app/en/"
}
