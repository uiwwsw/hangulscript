{
  "name": "@uiwwsw/hangulscript",
  "version": "0.5.0",
  "description": "한글 문장으로 작성하고 JavaScript와 타입 선언으로 배포하는 실험적 프로그래밍 언어",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/transformer.d.ts",
      "import": "./dist/transformer.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "bin": {
    "ksc": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LANGUAGE.md",
    "LICENSE",
    "examples/*.hgs"
  ],
  "scripts": {
    "build": "node ./scripts/build.js",
    "prepublishOnly": "npm test && npm run build",
    "test": "node --test",
    "build:site": "node scripts/build-site.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "dependencies": {
    "typescript": "^5.4.0"
  },
  "keywords": [
    "hangul",
    "korean",
    "hgs",
    "typescript",
    "transpiler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uiwwsw/hangulscript.git"
  },
  "bugs": {
    "url": "https://github.com/uiwwsw/hangulscript/issues"
  },
  "homepage": "https://github.com/uiwwsw/hangulscript#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "types": "dist/index.d.ts"
}
