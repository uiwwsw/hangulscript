{
  "name": "@uiwwsw/koreanscript",
  "version": "0.2.0",
  "description": "A tiny transpiler that lets you write TypeScript using Korean keywords.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/transformer.js"
  },
  "bin": {
    "ksc": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LANGUAGE.md",
    "LICENSE",
    "examples/*.ks"
  ],
  "scripts": {
    "build": "node ./scripts/build.js",
    "prepublishOnly": "npm test && npm run build",
    "test": "node --test",
    "build:site": "node scripts/build-site.js"
  },
  "dependencies": {
    "typescript": "^5.4.0"
  },
  "keywords": [
    "korean",
    "typescript",
    "transpiler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uiwwsw/koreanscript.git"
  },
  "bugs": {
    "url": "https://github.com/uiwwsw/koreanscript/issues"
  },
  "homepage": "https://github.com/uiwwsw/koreanscript#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
