{
  "name": "@uiwwsw/hangulscript",
  "version": "0.8.0",
  "description": "한글 문장으로 작성하고 JavaScript와 타입 선언으로 배포하는 프로그래밍 언어",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/transformer.d.ts",
      "import": "./dist/transformer.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./formatter": {
      "types": "./dist/formatter.d.ts",
      "import": "./dist/formatter.js"
    },
    "./register": "./dist/register.js",
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    }
  },
  "bin": {
    "ksc": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LANGUAGE.md",
    "LICENSE",
    "examples/*.hgs",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.js",
    "prepublishOnly": "npm test && npm run build",
    "test": "node --test",
    "build:site": "node scripts/build-site.js",
    "benchmark": "node scripts/benchmark.js",
    "build:vscode": "node scripts/build-vscode.js",
    "package:vscode": "npm run build:vscode && cd extensions/vscode && vsce package --no-dependencies",
    "test:vscode": "npm run build:vscode && node scripts/run-editor-qa.js"
  },
  "dependencies": {
    "typescript": "^5.4.0"
  },
  "keywords": [
    "hangul",
    "korean",
    "hgs",
    "typescript",
    "transpiler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uiwwsw/hangulscript.git"
  },
  "bugs": {
    "url": "https://github.com/uiwwsw/hangulscript/issues"
  },
  "homepage": "https://github.com/uiwwsw/hangulscript#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "marked": "^18.1.1"
  },
  "types": "dist/index.d.ts"
}
