{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "true",
  "outputDirectory": "vercel-proxy",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "koreanscript.vercel.app"
        }
      ],
      "destination": "https://hangulscript.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "https://hangulscript.movvcorp.duckdns.org/"
    },
    {
      "source": "/:path*",
      "destination": "https://hangulscript.movvcorp.duckdns.org/:path*"
    }
  ]
}
